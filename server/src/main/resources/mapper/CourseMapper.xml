<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjutzxq.server.mapper.CourseMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.bjutzxq.pojo.entity.Course">
        <id column="id" property="id"/>
        <result column="course_name" property="courseName"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, course_name
    </sql>

    <!-- 插入课程 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO course (course_name)
        VALUES (#{courseName})
    </insert>

    <!-- 根据 ID 删除 -->
    <delete id="deleteById">
        DELETE FROM course WHERE id = #{id}
    </delete>

    <!-- 更新课程 -->
    <update id="update">
        UPDATE course
        SET course_name = #{courseName}
        WHERE id = #{id}
    </update>

    <!-- 根据 ID 查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM course
        WHERE id = #{id}
    </select>

    <!-- 根据课程名称查询 -->
    <select id="selectByCourseName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM course
        WHERE course_name = #{courseName}
    </select>

    <!-- 查询所有课程 -->
    <select id="selectAllCourses" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM course
        ORDER BY course_name ASC
    </select>

    <!-- 模糊搜索课程 -->
    <select id="searchCourses" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM course
        WHERE course_name LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY course_name ASC
    </select>

  <select id="countAll" resultType="int">SELECT COUNT(*) FROM course</select>
</mapper>
