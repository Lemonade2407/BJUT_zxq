<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//myBatis//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjutzxq.server.mapper.CommentMapper">
    
    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.bjutzxq.pojo.entity.Comment">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="project_id" property="projectId"/>
        <result column="content" property="content"/>
        <result column="like_count" property="likeCount"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="status" property="status"/>
    </resultMap>
    
    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, user_id, project_id, content, like_count, created_at, updated_at, status
    </sql>

    <!-- 新增评论 -->
    <insert id="insert" parameterType="com.bjutzxq.pojo.entity.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comment (
            user_id,
            project_id,
            content,
            like_count,
            created_at,
            updated_at,
            status
        ) VALUES (
            #{userId},
            #{projectId},
            #{content},
            0,
            NOW(),
            NOW(),
            1
        )
    </insert>
    
    <!-- 根据 ID 查询评论 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT 
            <include refid="Base_Column_List"/>
        FROM comment
        WHERE id = #{id}
    </select>
    
    <!-- 根据项目 ID 查询评论列表（分页） -->
    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT 
            <include refid="Base_Column_List"/>
        FROM comment
        WHERE project_id = #{projectId} AND status = #{status}
        ORDER BY created_at DESC
    </select>
    
    <!-- 更新评论信息 -->
    <update id="updateById" parameterType="com.bjutzxq.pojo.entity.Comment">
        <set>
            <if test="content != null">content = #{content},</if>
            <if test="likeCount != null">like_count = #{likeCount},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>
    
    <!-- 删除评论 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM comment WHERE id = #{id}
    </delete>
    
    <!-- 统计项目评论数 -->
    <select id="countByProjectId" resultType="int">
        SELECT COUNT(*) 
        FROM comment
        WHERE project_id = #{projectId} AND status = 1
    </select>
    
    <!-- 统计评论总数 -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM comment
    </select>
    
    <!-- 根据用户 ID 删除所有评论 -->
    <delete id="deleteByUserId">
        DELETE FROM comment
        WHERE user_id = #{userId}
    </delete>
    
    <!-- 批量查询评论的用户信息（优化 N+1 问题） -->
    <select id="selectUserBatch" resultType="java.util.HashMap">
        SELECT id, username, avatar
        FROM user
        WHERE id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        <!-- 如果 userIds 为空，返回空结果 -->
        <if test="userIds == null or userIds.size() == 0">
            AND 1 = 0
        </if>
    </select>
    
    <!-- 获取项目所有者ID -->
    <select id="getProjectOwnerId" resultType="java.lang.Integer">
        SELECT owner_id FROM project WHERE id = #{projectId}
    </select>
    
    <!-- 获取项目名称 -->
    <select id="getProjectName" resultType="java.lang.String">
        SELECT name FROM project WHERE id = #{projectId}
    </select>

    <!-- 分页查询所有评论（管理员） -->
    <select id="selectAllWithPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM comment
        <where>
            <if test="status != null">
                status = #{status}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <!-- 按关键词搜索评论（管理员） -->
    <select id="searchByKeyword" resultMap="BaseResultMap">
        SELECT c.id, c.user_id, c.project_id, c.content, c.like_count, c.created_at, c.updated_at, c.status
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.id
        LEFT JOIN project p ON c.project_id = p.id
        WHERE c.content LIKE CONCAT('%', #{keyword}, '%')
           OR u.username LIKE CONCAT('%', #{keyword}, '%')
           OR p.name LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY c.created_at DESC
    </select>

    <!-- 统计关键词匹配的评论数 -->
    <select id="countByKeyword" resultType="int">
        SELECT COUNT(*)
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.id
        LEFT JOIN project p ON c.project_id = p.id
        WHERE c.content LIKE CONCAT('%', #{keyword}, '%')
           OR u.username LIKE CONCAT('%', #{keyword}, '%')
           OR p.name LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- 统计按状态的评论数（管理员） -->
    <select id="countByStatus" resultType="int">
        SELECT COUNT(*) FROM comment
        <where>
            <if test="status != null">
                status = #{status}
            </if>
        </where>
    </select>

    <!-- 物理删除评论 -->
    <delete id="forceDeleteById">
        DELETE FROM comment WHERE id = #{id}
    </delete>

    <!-- 批量获取项目名称 -->
    <select id="getProjectNamesBatch" resultType="java.util.HashMap">
        SELECT id, name FROM project WHERE id IN
        <foreach collection="projectIds" item="pid" open="(" separator="," close=")">#{pid}</foreach>
    </select>

  <select id="countByUserId" resultType="int">SELECT COUNT(*) FROM comment WHERE user_id=#{userId}</select>
  <select id="countByMonth" resultType="int">SELECT COUNT(*) FROM comment WHERE DATE_FORMAT(created_at,'%Y-%m')=#{month}</select>
  <select id="countByUserIdAndMonth" resultType="int">SELECT COUNT(*) FROM comment WHERE user_id=#{userId} AND DATE_FORMAT(created_at,'%Y-%m')=#{month}</select>
</mapper>
